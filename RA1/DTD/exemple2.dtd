<!-- Declara l'element 'arrel' que conté els fills 'c:esdeveniments' i 't:esdeveniments'-->
<!ELEMENT arrel (c:esdeveniments, t:esdeveniments)>
<!-- Declara l'atribut 'xmlns' per a l'etiqueta 'arrel' fent que CDATA
que permet qualsevol text i #REQUIRED fet l'atribut obligatori) -->
<!ATTLIST arrel xmlns CDATA #REQUIRED>
<!-- Declara l'atribut 'xmlns:c' per a l'etiqueta 'arrel' fent que CDATA
que permet qualsevol text i #REQUIRED fet l'atribut obligatori) -->
<!ATTLIST arrel xmlns:c CDATA #REQUIRED>
<!-- Declara l'atribut 'xmlns:t' per a l'etiqueta 'arrel' fent que CDATA
que permet qualsevol text i #REQUIRED fet l'atribut obligatori) -->
<!ATTLIST arrel xmlns:t CDATA #REQUIRED>

<!-- Declara l'element 'c:esdeveniments' que conté el fill 'c:esdeveniment' amb + que permet molts -->
<!ELEMENT c:esdeveniments (c:esdeveniment+)>
<!-- Declara l'element 'c:esdeveniment' que conté els fills 'c:grup', 'c:lloc', 'c:data' i 'c:entrada' -->
<!ELEMENT c:esdeveniment (c:grup, c:lloc, c:data, c:entrada)>
<!-- Declara l'element 'grup' que amb PCDATA que permet text-->
<!ELEMENT c:grup (#PCDATA)>
<!-- Declara l'element 'lloc' que amb PCDATA que permet text-->
<!ELEMENT c:lloc (#PCDATA)>
<!-- Declara l'element 'data' que amb PCDATA que permet text-->
<!ELEMENT c:data (#PCDATA)>
<!-- Declara l'element 'entrada' que amb PCDATA que permet text-->
<!ELEMENT c:entrada (#PCDATA)>
<!-- Declara l'atribut 'gratuita' a 'entrada' que amb CDATA
fem que permeti text, i amb #REQUIRED fem que sigui obligatori) -->
<!ATTLIST c:entrada gratuita CDATA #REQUIRED>

<!ELEMENT t:esdeveniments (t:esdeveniment+)>
<!ELEMENT t:esdeveniment (t:companyia, t:lloc, t:data, t:entrada)>
<!ELEMENT t:companyia (#PCDATA)>
<!ELEMENT t:lloc (#PCDATA)>
<!ELEMENT t:data (#PCDATA)>
<!ELEMENT t:entrada (#PCDATA)>
